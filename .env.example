# ==============================================================================
# CONFIGURAÇÃO DO BACKEND CORE (GO) - SHOPPING FLAMBOYANT
# ==============================================================================
# Copie este arquivo para .env nesta mesma pasta:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS POSTGRESQL (SUPABASE)
# ------------------------------------------------------------------------------
# String de conexão direta (porta 5432) ou Session Pooler (porta 5432) do Supabase.
# Obtenha em: Supabase Dashboard > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:sua_senha@db.sua_referencia.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. INTEGRAÇÃO GOOGLE CLOUD OAUTH 2.0 (FLUXO DO ORGANIZADOR)
# ------------------------------------------------------------------------------
# Credenciais criadas no Google Cloud Console > APIs & Services > Credentials
# Tipo: "Web application" (Aplicação Web)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret

# URI de redirecionamento autorizada cadastrada no Google Cloud Console
# Em desenvolvimento local:
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/oauth/google/callback
# Em produção:
# GOOGLE_OAUTH_REDIRECT_URL=https://jpmallflamboyant.live/api/oauth/google/callback

# ------------------------------------------------------------------------------
# 3. INTEGRAÇÃO COM FRONTEND & MICROSSERVIÇO DE AUTOMAÇÕES
# ------------------------------------------------------------------------------
# URL do frontend para onde o usuário será redirecionado após autorizar a conta Google
FRONTEND_BASE_URL=http://localhost:5173
# Em produção:
# FRONTEND_BASE_URL=https://jpmallflamboyant.live

# URL base do microsserviço de automações (Python FastAPI)
# Localmente: http://localhost:8000
# No Docker Compose interno: http://python-worker:8000
# Em produção via proxy reverso: https://jpmallflamboyant.live
AUTOMACOES_PUBLIC_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. SUPABASE STORAGE (OPCIONAL / UPLOADS)
# ------------------------------------------------------------------------------
# Utilizado caso utilize o serviço de upload de planilhas/anexos
SUPABASE_URL=https://sua_referencia.supabase.co
SUPABASE_KEY=sua_anon_ou_service_role_key
